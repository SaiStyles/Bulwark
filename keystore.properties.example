# Release signing. Copy to `keystore.properties` and fill in.
#
# **Never commit the real file or the keystore.** Both are gitignored, and the
# key must be generated offline and kept off CI - ROADMAP.md, v1.0. A lost or
# leaked signing key cannot be rotated for users who already installed: Android
# will refuse an update signed by anything else, and anyone holding it can ship
# an "update" to a phone that trusts Bulwark with shell access.
#
# Generate one, offline, on a machine you control:
#
#   keytool -genkeypair -v \
#     -keystore bulwark-release.jks \
#     -alias bulwark \
#     -keyalg RSA -keysize 4096 -validity 10000
#
# Then publish its fingerprint somewhere people can check it against a release:
#
#   keytool -list -v -keystore bulwark-release.jks -alias bulwark
#
# storeFile is resolved from the repository root.

storeFile=bulwark-release.jks
storePassword=
keyAlias=bulwark
keyPassword=

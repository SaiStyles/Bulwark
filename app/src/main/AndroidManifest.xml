<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Shizuku is the only privilege Bulwark has. Note what is NOT here:
        no INTERNET permission, and no QUERY_ALL_PACKAGES. The first is the
        zero-network rule made enforceable rather than promised; the second is
        the open question the visibility spike exists to answer.
    -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!--
        Defensive only, API 31+. Lets us call setHideOverlayWindows(true) so no
        other app can draw over a screen that authorises a destructive change.
        This permission GRANTS US NOTHING over other apps or your data - it only
        lets us refuse to be covered. See context/_shared/security.md.
    -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!--
        Required to show the authentication prompt that gates destructive
        actions. This is an ANTI-AUTOMATION control, not a login: a malicious
        Accessibility service can synthesise taps on our UI, and since Bulwark
        holds shell access, anything that can press our buttons holds shell by
        proxy. Only a prompt running outside our process breaks that chain.
        See context/_shared/security.md FIXED-11.

        Normal permission - no runtime prompt, and it grants no access to
        biometric data. It only lets us ASK the system to verify the user.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
        The firewall's tunnel. Note what is still NOT here: no INTERNET. Bulwark
        runs a VpnService and holds no permission to reach the network itself,
        which is exactly the shape this layer needs - blocked apps are routed
        into a tunnel that goes nowhere, and Bulwark could not forward their
        traffic if it wanted to.

        BIND_VPN_SERVICE below is declared ON the service, not requested by us:
        it says only the system may bind it. It grants Bulwark nothing.

        The user still has to approve the VPN through Android's own dialogue
        before a tunnel can be established. See context/layers/03-firewall.md.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

<!--
        NO ACCESS_NETWORK_STATE, and that is a decision rather than an
        oversight. Reading "is a VPN up" from ConnectivityManager needs it, and
        the no-network build check refused the build - correctly, since the
        constraint is that Bulwark declares nothing network-shaped at all.

        The check was not amended to let it through. The signal is available
        without any permission: the service that owns the tunnel knows whether
        it holds one, and every way that can go wrong - process killed, service
        stopped, consent revoked, phone rebooted - resets it to "no" on its own.
        See NetworkBlockService.isTunnelUp.
    -->

    <!--
        NO android:name here, deliberately. Shizuku starts the privileged user
        service in a stripped-down process that calls LoadedApk.makeApplication;
        a custom Application class NPEs there and the service never binds, with
        the app stuck on "connecting" and nothing in its own log.
        Verified on hardware 2026-09-10. See context/_shared/security.md.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bulwark">
        <!--
            taskAffinity="" and allowTaskReparenting="false" defend against
            StrandHogg / task-affinity hijacking, where a malicious app claims
            our affinity and gets its own screen shown when the user launches
            Bulwark. Android 11+ carries an OS-level fix, but minSdk is 26, so
            users on 8.0-10 rely entirely on this. See context/_shared/security.md.
        -->
        <activity
            android:name=".MainActivity"
            android:allowTaskReparenting="false"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Bulwark"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required for the Shizuku API to reach us. Guarded by a permission
             no normal app holds, so other apps cannot poke it. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <!--
            The tunnel that goes nowhere. android:permission means only the
            system may bind this - no other app can start or drive Bulwark's
            firewall.
        -->
        <service
            android:name=".firewall.NetworkBlockService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Shizuku is the only privilege Bulwark has. Note what is NOT here:
        no INTERNET permission, and no QUERY_ALL_PACKAGES. The first is the
        zero-network rule made enforceable rather than promised; the second is
        the open question the visibility spike exists to answer.
    -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />

    <!--
        Defensive only, API 31+. Lets us call setHideOverlayWindows(true) so no
        other app can draw over a screen that authorises a destructive change.
        This permission GRANTS US NOTHING over other apps or your data - it only
        lets us refuse to be covered. See context/_shared/security.md.
    -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <application
        android:name=".BulwarkApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bulwark">
        <!--
            taskAffinity="" and allowTaskReparenting="false" defend against
            StrandHogg / task-affinity hijacking, where a malicious app claims
            our affinity and gets its own screen shown when the user launches
            Bulwark. Android 11+ carries an OS-level fix, but minSdk is 26, so
            users on 8.0-10 rely entirely on this. See context/_shared/security.md.
        -->
        <activity
            android:name=".MainActivity"
            android:allowTaskReparenting="false"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.Bulwark"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Required for the Shizuku API to reach us. Guarded by a permission
             no normal app holds, so other apps cannot poke it. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>

</manifest>
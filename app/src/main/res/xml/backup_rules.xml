<?xml version="1.0" encoding="utf-8"?>
<!--
    Pre-API-31 counterpart to data_extraction_rules.xml. Backup is already
    disabled via android:allowBackup="false"; this is belt-and-braces so a
    future edit to the manifest cannot silently start backing up policy or
    action logs.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!--
  Bulwark's mark: a split shield, a keep, and the sweep that takes things off it.

  Redrawn as flat vector paths from SAI's artwork, 2026-09-15. The original is a
  rendered PNG with bevels, gradients and a glow, and none of that survives the
  size this is actually seen at - 48dp on a home screen, smaller in a share
  sheet. What survives is the silhouette, so the silhouette is what this keeps:
  the two-tone shield, the crenellated keep, the sweep across it, and the pixels
  coming off the edge.

  **Inside the safe zone.** An adaptive icon is 108x108 and a launcher may mask
  it to a circle, a squircle, or a rounded square, keeping only the central
  66dp. Everything here sits between 24 and 86, so no mask can crop the keep or
  clip the shield's point.

  Colours are the app's own: the green is `DarkPrimary`, the grey is the slate
  the shield's shadow side uses, and the fill under it all is `DarkBackground`.
  Opening the app should not feel like arriving somewhere else.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      **Scaled to the safe zone.** The mark is drawn at its natural size above
      and then pulled in: an adaptive icon's outer ring is decoration a launcher
      may crop to a circle, keeping only the central 66 of 108. Drawn full-bleed
      it looked right on this phone's squircle and would have lost the shield's
      shoulders and the trailing pixels on a rounder mask. Measured against the
      first render, 2026-09-15.
    -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.78"
        android:scaleY="0.78">

        <!-- Shield, lit side. -->
        <path
            android:fillColor="#4ADEA0"
            android:pathData="M54,20 L84,30 L84,54 C84,70 71,82 54,88 Z" />

        <!-- Shield, shadow side. The split is the whole idea: the same object,
             half of it in the light. -->
        <path
            android:fillColor="#46555E"
            android:pathData="M54,20 L24,30 L24,54 C24,70 37,82 54,88 Z" />

        <!-- Hollowed out, so the shield reads as a wall and not a slab. -->
        <path
            android:fillColor="#0E1513"
            android:pathData="M54,27 L78,35 L78,54 C78,66 68,76 54,81 C40,76 30,66 30,54 L30,35 Z" />

        <!-- The keep: battlements, then a body that widens to the ground. -->
        <path
            android:fillColor="#F2F5F4"
            android:pathData="M42,45 L42,35 L47,35 L47,40 L51.5,40 L51.5,35 L56.5,35 L56.5,40 L61,40 L61,35 L66,35 L66,45 Z" />
        <path
            android:fillColor="#F2F5F4"
            android:pathData="M44,45 L64,45 L66,72 L42,72 Z" />

        <!-- Its shadow side, echoing the shield's split down the same axis. -->
        <path
            android:fillColor="#C3CBCE"
            android:pathData="M42,45 L42,35 L47,35 L47,40 L51.5,40 L51.5,35 L54,35 L54,45 Z" />
        <path
            android:fillColor="#C3CBCE"
            android:pathData="M44,45 L54,45 L54,72 L42,72 Z" />

        <!-- The doorway, cut back to the ground colour. -->
        <path
            android:fillColor="#0E1513"
            android:pathData="M49.5,72 L49.5,64 C49.5,61.5 51.5,59.5 54,59.5 C56.5,59.5 58.5,61.5 58.5,64 L58.5,72 Z" />

        <!-- The sweep, crossing the keep rather than sitting under it - it is the
             thing being taken off, so it has to pass through. -->
        <path
            android:fillColor="#4ADEA0"
            android:pathData="M32,55 C42,64 64,61 74,48 L78,53 C67,67 41,70 30,60 Z" />

        <!-- Coming off the edge: what was taken away, leaving. -->
        <path
            android:fillColor="#4ADEA0"
            android:pathData="M79,44 L84,44 L84,49 L79,49 Z" />
        <path
            android:fillColor="#4ADEA0"
            android:pathData="M86,38 L90,38 L90,42 L86,42 Z" />
        <path
            android:fillColor="#4ADEA0"
            android:pathData="M81,52 L84,52 L84,55 L81,55 Z" />

    </group>
</vector>

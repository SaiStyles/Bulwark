<?xml version="1.0" encoding="utf-8"?>
<!--
  The icon's ground: the app's own dark surface, not the template's green grid.

  Flat on purpose. An adaptive icon's background is masked to whatever shape the
  launcher wants, gets parallaxed, and is seen at 48dp - texture there is
  texture nobody resolves. The colour is `DarkBackground` from the palette, so
  the icon and the app it opens are the same object.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#0E1513"
        android:pathData="M0,0h108v108h-108z" />
</vector>
